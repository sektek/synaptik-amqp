    "@sektek/prettier-config": "^2.0.0",
    "@types/amqplib": "^0.10.7",
    "@types/chai": "^4.3.11",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.6",
    "@types/node": "^24.0.10",
    "@types/sinon": "^21.0.1",
    "@types/sinon-chai": "^4.0.0",
    "c8": "^10.1.3",
    "chai": "^5.1.1",
    "chai-as-promised": "^8.0.2",
    "eslint": "^9.39.1",
    "mocha": "^10.4.0",
    "prettier": "^3.2.5",
    "release-it": "^19.2.4",
    "sinon": "^21.1.2",
    "sinon-chai": "^4.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
